# Canonical local runtime repository: code only, no deployment state or secrets.
/*
!/.gitignore
!/.envrc
!/LICENSE
!/CLAUDE.md
!/LICENSES/
!/NOTICE
!/README.md
!/install.sh
!/URACE.md
!/CONSOLIDATION.md
!/AGENTS.md
!/CONTRIBUTING.md
!/GOVERNANCE.md
!/MAINTAINERS
!/OPERATORS.md
!/SECURITY.md
!/.coderabbit.yaml
!/.github/
!/runtime/
!/core/
!/trial/
!/docs/
!/exchange/

/runtime/*
!/runtime/README.md
!/runtime/portfolio-workflow.template.json
!/runtime/pyproject.toml
!/runtime/build_initial_ledger.py
!/runtime/urace/
!/runtime/tests/
/runtime/urace/*
!/runtime/urace/*.py
!/runtime/urace/CLAUDE.md
!/runtime/urace/config.json
!/runtime/urace/cli/
!/runtime/urace/web/
!/runtime/urace/source_adapters/
/runtime/tests/*
!/runtime/tests/*.py

# core (Rust workspace) — whitelist source, block build artifacts
/core/*
!/core/Cargo.toml
!/core/Cargo.lock
!/core/PLAN.md
!/core/crates/
/core/crates/*
!/core/crates/urace-crypto/
!/core/crates/urace-types/
!/core/crates/urace-ledger/
!/core/crates/urace-identity/
!/core/crates/urace-cost/
!/core/crates/sources-lib/
!/core/crates/urace-authority/
!/core/crates/urace-p2p/
!/core/crates/urace-executor/
!/core/crates/urace-settlement/
!/core/crates/urace-artifacts/
!/core/crates/urace-products/
!/core/crates/urace-qualify/
!/core/crates/urace-work/
!/core/crates/urace-goals/
!/core/crates/urace-net/
!/core/crates/urace-upgrade/
!/core/crates/urace-audit/
!/core/crates/urace-tui/
!/core/crates/urace-schema/
!/core/crates/urace-mcp/
!/core/crates/urace-state/
!/core/crates/urace/

# Runtime/operational data — gitignored
generated/
state/
reports/
dev/

# Exchange: token contract stub only; initial_ledger published on stable release
exchange/*
!exchange/token_contract.json

# Secrets and env
secrets/
.env
.env.*
*.lock

# Python artifacts
__pycache__/
*.pyc
*.pyo

!/URACE.md
!/NOTICE
!/LICENSES/
/.ai-switch

# Trial runtime state (large, generated)
/trial/*.json
/trial/*.jsonl
/trial/*.log
/trial/*.guard
/trial/before-*
/trial/.before-*
/trial/benchmarks/
/trial/core-state/
/trial/downstream-studies/
/trial/engine-versions/
/trial/executable-evaluations/
/trial/history/
/trial/qualification-wheels/
/trial/reports/
/trial/repository-studies/
/trial/runs/
/trial/runtime-cycles/
/trial/runtime-evaluations/
/trial/snapshots/
/trial/transport/
/trial/transport-probes/
/trial/versions/
/trial/work/
/trial/workflow-studies/
/trial/urace/
