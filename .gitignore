# Canonical local runtime repository: code only, no deployment state or secrets.
/*
!/.gitignore
!/.envrc
!/LICENSE
!/LICENSES/
!/NOTICE
!/README.md
!/URACE.md
!/CONSOLIDATION.md
!/AGENTS.md
!/CONTRIBUTING.md
!/GOVERNANCE.md
!/MAINTAINERS
!/OPERATORS.md
!/SECURITY.md
!/.github/
!/packaging/
!/runtime/
!/trial/
!/docs/
!/products/
!/exchange/
/runtime/*
!/runtime/README.md
!/runtime/portfolio-workflow.template.json
!/runtime/pyproject.toml
!/runtime/build_initial_ledger.py
!/runtime/urace/
!/runtime/tests/
/runtime/urace/*
!/runtime/urace/*.py
/runtime/tests/*
!/runtime/tests/*.py

# Runtime/operational data — gitignored
generated/
state/
reports/
dev/

# Exchange: network ledger is runtime data; initial_ledger is committed reference
exchange/*
!exchange/initial_ledger/

# Secrets and env
secrets/
.env
.env.*
*.lock

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Products are user data — only README committed (see products/.gitignore)
/products/*
!/products/README.md
!/products/versions/
/products/versions/*
!/products/versions/README.md
!/URACE.md
!/NOTICE
!/LICENSES/
/.ai-switch


# Trial runtime state (large, generated)
/trial/*.json
/trial/*.jsonl
/trial/*.log
/trial/*.guard
/trial/before-*
/trial/.before-*
/trial/benchmarks/
/trial/core-state/
/trial/downstream-studies/
/trial/engine-versions/
/trial/executable-evaluations/
/trial/history/
/trial/qualification-wheels/
/trial/reports/
/trial/repository-studies/
/trial/runs/
/trial/runtime-cycles/
/trial/runtime-evaluations/
/trial/snapshots/
/trial/transport/
/trial/transport-probes/
/trial/versions/
/trial/work/
/trial/workflow-studies/
/trial/urace/

# Products runtime state
/products/*/state.json
/products/*/ledger.jsonl
/products/*/ledger.jsonl.pq
