# URACE repository — code only, no build artifacts, secrets, or runtime state.
/*
!/.gitignore
!/LICENSE
!/CLAUDE.md
!/LICENSES/
!/NOTICE
!/README.md
!/install.sh
!/install.ps1

!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/GOVERNANCE.md
!/MAINTAINERS
!/OPERATORS.md
!/SECURITY.md
!/.coderabbit.yaml
!/.github/
!/core/
!/docs/
!/exchange/

# core (Rust workspace) — whitelist source, block build artifacts
/core/*
!/core/Cargo.toml
!/core/Cargo.lock
!/core/crates/
/core/crates/*
!/core/crates/urace-artifacts/
!/core/crates/urace-audit/
!/core/crates/urace-authority/
!/core/crates/urace-cost/
!/core/crates/urace-crypto/
!/core/crates/urace-executor/
!/core/crates/urace-goals/
!/core/crates/urace-identity/
!/core/crates/urace-ledger/
!/core/crates/urace-mcp/
!/core/crates/urace-net/
!/core/crates/urace-net-types/
!/core/crates/urace-economics/
!/core/crates/urace-audit-types/
!/core/crates/urace-p2p/
!/core/crates/urace-p2p-analysis/
!/core/crates/urace-benchmarking/
!/core/crates/urace-project-work/
!/core/crates/urace-product/
!/core/crates/urace-qualification/
!/core/crates/urace-schema/
!/core/crates/urace-settlement/
!/core/crates/urace-state/
!/core/crates/urace-tui/
!/core/crates/urace-types/
!/core/crates/urace-upgrade/
!/core/crates/urace-exchange/
!/core/crates/urace-primitives/
!/core/crates/urace-web/
!/core/crates/urace-work/
!/core/crates/urace-work-types/
!/core/crates/urace/

# Exchange: token contract stub only; initial_ledger published on stable release
exchange/*
!exchange/token_contract.json

# Secrets and env
secrets/
.env
.env.*
*.lock

# Build / runtime artifacts — also block inside whitelisted dirs
generated/
state/
reports/
dev/
__pycache__/
*.pyc
*.pyo
/.ai-switch
/PROGRESS.md
